# =================================
# TELEGRAM BOT CONFIGURATION
# =================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook
TELEGRAM_ADMIN_IDS=123456789,987654321

# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL=postgresql://username:password@localhost:5432/telegram_sms_bot
REDIS_URL=redis://localhost:6379

# =================================
# TWILIO CONFIGURATION (Primary Provider)
# =================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# =================================
# ONVOY CONFIGURATION (Backup Provider)
# =================================
ONVOY_API_KEY=your_onvoy_api_key
ONVOY_API_SECRET=your_onvoy_secret
ONVOY_ENABLED=false

# =================================
# GOOGLE VOICE CONFIGURATION (Tertiary Provider)
# =================================
GOOGLE_VOICE_EMAIL=your_email@gmail.com
GOOGLE_VOICE_PASSWORD=your_password
GOOGLE_VOICE_ENABLED=false

# =================================
# CRYPTOCLOUD API CONFIGURATION
# =================================
CRYPTOCLOUD_API_KEY=your_cryptocloud_api_key
CRYPTOCLOUD_SHOP_ID=your_shop_id
CRYPTOCLOUD_WEBHOOK_SECRET=your_webhook_secret
CRYPTOCLOUD_ENABLED=true

# =================================
# TELEGRAM PAYMENT API CONFIGURATION
# =================================
TELEGRAM_PAYMENT_PROVIDER_TOKEN=your_provider_token
TELEGRAM_PAYMENTS_ENABLED=true

# =================================
# PRICING CONFIGURATION (in credits)
# =================================
# SMS Pricing
SMS_PRICE_DOMESTIC=1
SMS_PRICE_INTERNATIONAL=3

# Call Pricing (per minute)
CALL_PRICE_DOMESTIC_PER_MINUTE=2
CALL_PRICE_INTERNATIONAL_PER_MINUTE=5

# Credit Packages (amount:credits:bonus)
CREDIT_PACKAGES=5:500:0,10:1100:100,25:2875:375,50:6000:1000,100:13000:3000

# =================================
# SYSTEM CONFIGURATION
# =================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Session & Security
SESSION_SECRET=your_random_secret_key_change_this
JWT_SECRET=your_jwt_secret_key_change_this

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# File Upload
MAX_FILE_SIZE_MB=10

# =================================
# WEBHOOK URLS
# =================================
TWILIO_WEBHOOK_URL=https://yourdomain.com/webhooks/twilio
CRYPTOCLOUD_WEBHOOK_URL=https://yourdomain.com/webhooks/cryptocloud

# =================================
# OPTIONAL MONITORING
# =================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# =================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@yourdomain.com

# =================================
# BACKUP CONFIGURATION (Optional)
# =================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BUCKET=your-backup-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =================================
# FEATURE FLAGS
# =================================
ENABLE_SCHEDULED_SMS=false
ENABLE_BULK_SMS=false
ENABLE_CALL_RECORDING=false
ENABLE_TWO_WAY_SMS=false
ENABLE_REFERRAL_PROGRAM=false

# =================================
# DEVELOPMENT ONLY
# =================================
DEBUG=false
MOCK_TWILIO=false
MOCK_PAYMENTS=false
